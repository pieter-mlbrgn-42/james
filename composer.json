{
    "name": "pieter-mlbrgn-42/james",
    "description": "Git hooks",
    "type": "library",
    "authors": [
        {
            "name": "Pieter Hustinx",
            "email": "pieter.hustinx@mlbrgn.nl"
        }
    ],
    "require": {},
    "scripts": {
        "post-install-cmd": [
            "@php -r copy('hooks/pre-commit', '.git/hooks/pre-commit');",
            "@php -r copy('hooks/post-merge', '.git/hooks/post-merge');"
        ],
        "post-update-cmd": [
            "@php -r copy('hooks/pre-commit', '.git/hooks/pre-commit');",
            "@php -r copy('hooks/post-merge', '.git/hooks/post-merge');"
        ]
    }
}
